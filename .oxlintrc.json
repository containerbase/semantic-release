{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "promise", "oxc"],
  "jsPlugins": ["@containerbase/oxlint-plugin"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/",
    "tmp/",
    "bin/",
    "coverage/",
    "html/",
    "packages/*/lib/",
    ".claude/worktrees/",
    ".pnpm-store"
  ],
  "rules": {
    "containerbase/enforce-ts-extension": "off",
    "containerbase/no-undeclared-dependencies": "error",
    "containerbase/organize-imports": "error",
    "containerbase/test-root-describe": "error",

    "import/default": "error",
    "import/named": "error",
    "import/namespace": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/export": "error",
    "import/no-named-as-default": "error",

    "curly": ["error", "all"],
    "require-await": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-prototype-builtins": "error",
    "no-useless-escape": "error",
    "no-fallthrough": "error",
    "no-unused-vars": ["error", { "vars": "all", "args": "after-used", "argsIgnorePattern": "^_" }],
    "no-unused-expressions": "error",
    "no-empty-function": "error",
    "no-array-constructor": "error",

    "sort-imports": [
      "error",
      {
        "ignoreCase": false,
        "ignoreDeclarationSort": true,
        "ignoreMemberSort": false,
        "memberSyntaxSortOrder": ["none", "all", "multiple", "single"]
      }
    ],

    "object-shorthand": ["error", "always", { "avoidQuotes": true }],

    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "as", "objectLiteralTypeAssertions": "allow" }
    ],
    "typescript/explicit-function-return-type": [
      "error",
      { "allowExpressions": true, "allowTypedFunctionExpressions": true }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true, "allowBoolean": true }
    ],
    "typescript/unbound-method": ["error", { "ignoreStatic": true }],
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/array-type": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-tslint-comment": "error",
    "typescript/class-literal-property-style": "error",
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/dot-notation": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/require-await": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-this-alias": "error",

    "promise/always-return": "error",
    "promise/catch-or-return": "error",
    "promise/no-callback-in-promise": "error",
    "promise/no-nesting": "error",
    "promise/no-new-statics": "error",
    "promise/no-promise-in-callback": "error",
    "promise/no-return-in-finally": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/valid-params": "error"
  },
  "overrides": [
    {
      "files": ["tools/**"],
      "rules": {
        "containerbase/no-undeclared-dependencies": ["error", { "allowDevDependencies": true }]
      }
    },
    {
      "files": ["**/*.{js,mjs,cjs}"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "typescript/restrict-template-expressions": "off"
      }
    }
  ]
}

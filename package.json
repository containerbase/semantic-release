{
  "name": "semantic-release",
  "private": true,
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@gmx.de>",
  "type": "module",
  "scripts": {
    "build": "run-s \"build:*\"",
    "build:pnpm": "node tools/build.js",
    "lint": "run-s oxfmt oxlint lint:types",
    "lint-fix": "run-s oxfmt-fix oxlint-fix",
    "lint:types": "run-p \"lint:types:*\"",
    "lint:types:default": "tsc",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepare": "run-s \"prepare:*\"",
    "prepare:build": "run-s \"build:*\"",
    "prepare:husky": "husky"
  },
  "devDependencies": {
    "@containerbase/oxlint-plugin": "1.1.0",
    "@containerbase/semantic-release-pnpm": "workspace:*",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "22.20.5",
    "@types/semantic-release__error": "3.0.3",
    "@types/semver": "7.8.0",
    "@types/signale": "1.4.7",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "npm-run-all2": "8.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.11.0 || ^24",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
